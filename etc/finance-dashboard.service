# Example systemd unit for Finance Dashboard. Copy it to
# /etc/systemd/system/ and adjust the user, the paths, the port and the
# root path before enabling it.
#
# It carries no hostname, no certificate and no credential. For this sample
# deployment, Basic authentication credentials and the session secret key
# belong in config.yml in the working directory. The deployment owner keeps
# file ownership and the service group receives read access; the service group
# must not receive write access and other users receive no access.
#
# Do not put secret values directly in Environment= lines in this sample unit.
# The Environment= line below carries only the non-secret root path.
#
# If User= is changed, set Group= to that user's primary group and use
# the same user as APP_USER for deploy.sh. The deployment script resolves
# that primary group with id -gn and never changes the file owner.
#
# The application binds 127.0.0.1. Apache is the entrance from outside
# and uvicorn is never exposed directly, which is what lets the dashboard
# be published over HTTPS without TLS in this process. The root path is
# set twice on purpose: --root-path tells uvicorn where the application
# is mounted so that generated URLs carry the prefix, and the
# environment variable tells the settings loader the same thing. Both
# must match the path Apache proxies, /finance-dashboard here.
#
# See doc/DEPLOYMENT.md for the whole procedure.

[Unit]
Description=Finance Dashboard
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/finance-dashboard
Environment=FINANCE_DASHBOARD_ROOT_PATH=/finance-dashboard
ExecStart=/var/www/finance-dashboard/.venv/bin/uvicorn finance_dashboard.main:app \
    --host 127.0.0.1 --port 3000 --root-path /finance-dashboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
